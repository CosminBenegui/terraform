# Downloaded providers / modules (local cache)
.terraform/

# Lock file: COMMIT this for apps/root modules (pin provider versions)
# Do NOT ignore: .terraform.lock.hcl

# State (never commit — secrets + real infra IDs live here)
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform.tfstate.d/
.terraform.tfstate.lock.info

# Plans / crash dumps
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files with secrets (use example.tfvars / *.tfvars.example instead)
*.tfvars
*.tfvars.json
!example.tfvars
!*.tfvars.example

# CLI config (may contain credentials)
.terraformrc
terraform.rc

# Generated by this demo
hello-*.txt

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local helper scripts
_vm_*.py

# Runner credential backups must never be in git
runner-backup/

# Generated on the Debian host
secrets.env
.env
