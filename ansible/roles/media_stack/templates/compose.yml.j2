services:
  plex:
    image: lscr.io/linuxserver/plex:latest
    container_name: plex
    restart: unless-stopped
    networks: [media]
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: Europe/Bucharest
      VERSION: docker
    volumes:
      - plex-config-test:/config
      - /home/cosmin/media/movies:/movies
      - /home/cosmin/media/tv:/tv
    ports:
      - "32400:32400"
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    restart: unless-stopped
    networks: [media]
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: Europe/Bucharest
    volumes:
      - prowlarr-config-test:/config
    ports:
      - "9696:9696"
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    restart: unless-stopped
    networks: [media]
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: Europe/Bucharest
    volumes:
      - radarr-config-test:/config
      - /home/cosmin/media/movies:/movies
      - /home/cosmin/media/downloads:/downloads
    ports:
      - "7878:7878"
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    restart: unless-stopped
    networks: [media]
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: Europe/Bucharest
    volumes:
      - sonarr-config-test:/config
      - /home/cosmin/media/tv:/tv
      - /home/cosmin/media/downloads:/downloads
    ports:
      - "8989:8989"
  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    container_name: seerr
    restart: unless-stopped
    networks: [media]
    environment:
      TZ: Europe/Bucharest
      PORT: "5055"
    volumes:
      - seerr-config-test:/app/config
    ports:
      - "5055:5055"
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    restart: unless-stopped
    networks: [media]
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: Europe/Bucharest
      WEBUI_PORT: "8080"
    volumes:
      - qbittorrent-config-test:/config
      - /home/cosmin/media/downloads:/downloads
    ports:
      - "8080:8080"
      - "6881:6881"
      - "6881:6881/udp"

networks:
  media:
    name: media-net-test
    external: true

volumes:
  plex-config-test:
    external: true
  prowlarr-config-test:
    external: true
  radarr-config-test:
    external: true
  sonarr-config-test:
    external: true
  seerr-config-test:
    external: true
  qbittorrent-config-test:
    external: true
