services:
  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped
    networks: [media]
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: "1234"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      GF_AUTH_PROXY_ENABLED: "true"
      GF_AUTH_PROXY_HEADER_NAME: X-authentik-username
      GF_AUTH_PROXY_AUTO_SIGN_UP: "true"
      GF_SERVER_ROOT_URL: https://grafana.lab.home
    volumes:
      - grafana-data:/var/lib/grafana
      - /var/lib/lab/compose/grafana/provisioning:/etc/grafana/provisioning:ro
  loki:
    image: grafana/loki:latest
    container_name: loki
    restart: unless-stopped
    networks: [media]
    command: ["-config.file=/etc/loki/loki.yml"]
    volumes:
      - /var/lib/lab/compose/grafana/loki.yml:/etc/loki/loki.yml:ro
      - loki-data:/loki
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: unless-stopped
    networks: [media]
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.enable-remote-write-receiver
    volumes:
      - /var/lib/lab/compose/grafana/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
  alloy:
    image: grafana/alloy:latest
    container_name: alloy
    restart: unless-stopped
    networks: [media]
    command:
      - run
      - --server.http.listen-addr=127.0.0.1:12345
      - --storage.path=/var/lib/alloy/data
      - /etc/alloy/config.alloy
    volumes:
      - /var/lib/lab/compose/grafana/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro
      - alloy-data:/var/lib/alloy

networks:
  media:
    name: media-net-test
    external: true

volumes:
  grafana-data:
  loki-data:
  prometheus-data:
  alloy-data:
