version: 1
metadata:
  name: Media proxy apps
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_core.user
    identifiers:
      username: admin
    attrs:
      name: admin
      email: admin@lab.home
      is_active: true
      password: "1234"
      path: users
      groups:
        - !Find [authentik_core.group, [name, authentik Admins]]
{% for app in media_apps %}
  - model: authentik_providers_proxy.proxyprovider
    id: provider-{{ app.slug }}
    identifiers:
      name: {{ app.name }}
    attrs:
      mode: forward_single
      external_host: https://{{ app.host }}
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
  - model: authentik_core.application
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: {{ app.name }}
      slug: {{ app.slug }}
      provider: !KeyOf provider-{{ app.slug }}
      meta_launch_url: https://{{ app.host }}
      policy_engine_mode: any
{% endfor %}
  - model: authentik_outposts.outpost
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      type: proxy
      config:
        authentik_host: https://auth.lab.home
        authentik_host_browser: https://auth.lab.home
      providers:
{% for app in media_apps %}
        - !Find [authentik_providers_proxy.proxyprovider, [name, {{ app.name }}]]
{% endfor %}
  - model: authentik_providers_proxy.proxyprovider
    state: absent
    identifiers:
      name: Netdata
  - model: authentik_core.application
    state: absent
    identifiers:
      slug: netdata
