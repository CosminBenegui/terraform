http:
  middlewares:
    authentik:
      forwardAuth:
        address: http://authentik:9000/outpost.goauthentik.io/auth/traefik
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - X-authentik-jwt
          - X-authentik-meta-jwks
          - X-authentik-meta-outpost
          - X-authentik-meta-provider
          - X-authentik-meta-app
          - X-authentik-meta-version
  routers:
    auth:
      rule: Host(`auth.lab.home`)
      entryPoints: [websecure]
      service: authentik
      tls: {}
{% for app in media_apps %}
    {{ app.slug }}:
      rule: Host(`{{ app.host }}`)
      entryPoints: [websecure]
      middlewares: [authentik]
      service: {{ app.slug }}
      tls: {}
{% endfor %}
  services:
    authentik:
      loadBalancer:
        servers:
          - url: http://authentik:9000
{% for app in media_apps %}
    {{ app.slug }}:
      loadBalancer:
        servers:
          - url: {{ app.upstream }}
{% endfor %}
